# ==========================================
# CLUBVERSE Backend Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Client URL (for CORS allowance, supports comma-separated URLs)
# Local: http://localhost:5173
# Production on Render: https://clubverse-three.vercel.app
CLIENT_URL=https://clubverse-three.vercel.app,http://localhost:5173

# Supabase PostgreSQL Connection Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret for Admin Session Signing
JWT_SECRET=super_secret_clubverse_jwt_key_2026
JWT_EXPIRES_IN=24h
